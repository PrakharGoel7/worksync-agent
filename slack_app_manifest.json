{
    "display_information": {
        "name": "Rundown",
        "description": "Turns team activity into a concise manager briefing.",
        "background_color": "#1a1a2e"
    },
    "features": {
        "bot_user": {
            "display_name": "Rundown",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "channels:history",
                "channels:read",
                "channels:join",
                "groups:history",
                "groups:read",
                "im:write",
                "chat:write",
                "users:read"
            ]
        }
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "is_hosted": false,
        "token_rotation_enabled": false
    }
}
