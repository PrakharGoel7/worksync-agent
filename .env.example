# Slack bot token (xoxb-...) — requires scopes listed below
SLACK_BOT_TOKEN=xoxb-your-token-here

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Slack user ID of the manager who receives the digest (e.g. U012AB3CD)
MANAGER_SLACK_ID=U012AB3CD

# Comma-separated channel names (no #) to monitor
SLACK_CHANNELS=engineering,product,design

# How many days back to look (default: 7)
LOOKBACK_DAYS=7

# Optional: override the Claude model
# CLAUDE_MODEL=claude-sonnet-4-6
